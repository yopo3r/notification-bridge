    <!-- Onboarding -->
    <string name="onboarding_step_indicator">ステップ %1$d / %2$d</string>
    <string name="onboarding_next">次へ</string>
    <string name="onboarding_back">戻る</string>
    <string name="onboarding_skip">スキップ</string>
    <string name="onboarding_finish">始める</string>
    <string name="onboarding_step1_title">このアプリについて</string>
    <string name="onboarding_step1_desc">Notification Bridgeは、このスマートフォンの通知をBluetooth経由で別のデバイス（ガラケーなど）に転送します。インターネットは不要で、受信側にアプリを入れる必要もありません。</string>
    <string name="onboarding_step2_title">相手のデバイスをペアリング</string>
    <string name="onboarding_step2_desc">アプリを使う前に、AndroidのBluetooth設定から受信側のスマートフォンをペアリングしてください。ヘッドホンをペアリングするのと同じ手順です。</string>
    <string name="onboarding_step3_title">Bluetoothデバイスを選択</string>
    <string name="onboarding_step3_desc">このアプリのテストタブで、通知を受け取るペアリング済みのデバイスをリストから選んでください。</string>
    <string name="onboarding_step4_title">通知へのアクセスを許可</string>
    <string name="onboarding_step4_desc">ホームで「通知へのアクセス」をタップし、システム設定でこのアプリの権限を有効にしてください。この手順を行わないと、通知を読み取れません。</string>
    <string name="onboarding_step5_title">転送するアプリを選択</string>
    <string name="onboarding_step5_desc">設定で、通知を転送したいアプリ（WhatsApp、メールなど）にチェックを入れ、「ブリッジを有効にする」をオンにしてください。</string>
    <string name="onboarding_step6_title">テストを送信</string>
    <string name="onboarding_step6_desc">テストタブで「テストファイルを送信」をタップし、実際の通知に頼る前にBluetooth転送が動作することを確認してください。</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">チュートリアルを表示</string>
    <string name="about_version">バージョン %1$s</string>
    <string name="about_description">Androidの通知をBluetooth（OBEX Object Push）で別のデバイスに転送します。専用アプリを持たないガラケーと組み合わせて使うことを想定しています。</string>
    <string name="about_purpose_title">プロジェクトの目的</string>
    <string name="about_purpose_body">メインのデバイスとしてインターネットに接続されたスマートフォンに頼らずに、誰からメッセージや着信があったかを知るための、個人のオープンソースプロジェクトです。</string>
    <string name="about_technical_title">技術概要</string>
    <string name="about_technical_body">NotificationListenerService + メモリ内キュー + RFCOMM Bluetoothソケット上の自作OBEX Object Pushクライアント。受信機としてAlcatel 3080Aで動作確認済み。</string>
    <string name="about_technologies_title">使用技術</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">ライセンス</string>
    <string name="about_license_body">MIT — リポジトリのLICENSEファイルを参照してください。</string>

