    <string name="settings_backup_import">Konfiguration importieren</string>
    <string name="backup_export_title">Konfiguration exportieren</string>
    <string name="backup_export_receiver_hint">Wähle, was zum Empfänger gespeichert wird. Mit der Bluetooth-Adresse kann ein anderes Telefon denselben Empfänger direkt auswählen, sie identifiziert aber das Gerät: Lass sie weg, wenn du die Datei teilst.</string>
    <string name="backup_export_receiver_name">Nur Empfängername (empfohlen)</string>
    <string name="backup_export_receiver_none">Kein Empfänger</string>
    <string name="backup_export_receiver_address">Name und Bluetooth-Adresse</string>
    <string name="backup_export_confirm">Speicherort wählen</string>
    <string name="backup_exported">Konfiguration gespeichert.</string>
    <string name="backup_export_error">Konfiguration nicht gespeichert: %1$s</string>
    <string name="backup_import_title">Diese Konfiguration importieren?</string>
    <string name="backup_import_body">Dies ersetzt erlaubte Apps, Filter, Bündelung, maximale Textlänge, Design, Sprache und Dumbphone-Modus durch die Werte aus der Datei. Der Bridge-Schalter bleibt unverändert.</string>
    <string name="backup_import_receiver">Empfänger: %1$s</string>
