    <string name="onboarding_step1_title">Qué hace esta aplicación</string>
    <string name="onboarding_step1_desc">Notification Bridge reenvía las notificaciones de este teléfono a otro dispositivo (por ejemplo, un teléfono básico) mediante Bluetooth, sin necesidad de conexión a Internet ni de instalar una aplicación en el receptor.</string>
    <string name="onboarding_step2_title">Emparejar el otro dispositivo</string>
    <string name="onboarding_step2_desc">Antes de usar la aplicación, empareja el teléfono receptor desde la configuración de Bluetooth de Android, igual que harías con unos auriculares.</string>
    <string name="onboarding_step3_title">Elegir el dispositivo Bluetooth</string>
    <string name="onboarding_step3_desc">En la pestaña Receptor, elige de la lista el dispositivo emparejado que recibirá las notificaciones.</string>
    <string name="onboarding_step4_title">Dar acceso a notificaciones</string>
    <string name="onboarding_step4_desc">Desde Inicio, toca «Acceso a notificaciones» y concede el permiso a esta aplicación en la configuración del sistema. Sin este paso, la aplicación no puede leer las notificaciones.</string>
    <string name="onboarding_step5_title">Seleccionar aplicaciones para reenviar</string>
    <string name="onboarding_step5_desc">En Ajustes, selecciona las aplicaciones cuyas notificaciones quieres reenviar (por ejemplo, mensajería o correo) y activa el interruptor «Activar bridge».</string>
    <string name="onboarding_step6_title">Probar el envío</string>
    <string name="onboarding_step6_desc">En la pestaña Receptor, toca «Enviar archivo único» para confirmar que la transferencia por Bluetooth funciona antes de reenviar notificaciones.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Ver tutorial</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_description">Reenvía notificaciones de Android a otro dispositivo mediante Bluetooth (OBEX Object Push), para usarlo junto a un teléfono básico sin aplicaciones propias.</string>
    <string name="about_purpose_title">Propósito del proyecto</string>
    <string name="about_purpose_body">Proyecto personal de código abierto para saber quién escribe o llama sin depender de un teléfono inteligente con conexión a Internet como dispositivo principal.</string>
    <string name="about_technical_title">Información técnica</string>
    <string name="about_technical_body">NotificationListenerService + cola en memoria + cliente OBEX Object Push propio sobre un socket Bluetooth RFCOMM. Probado con un Alcatel 3080A como receptor.</string>
    <string name="about_technologies_title">Tecnologías utilizadas</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">Licencia</string>
    <string name="about_license_body">MIT — ver el archivo LICENSE en el repositorio.</string>

