    <string name="diagnostics_title">Diagnóstico</string>
    <string name="diagnostics_intro">El informe incluye versión, versión de Android, modelo del teléfono, ajustes y estados técnicos. Omite los detalles de errores y el registro, que pueden contener datos personales. Revísalo antes de compartirlo. No incluye el contenido de notificaciones, el nombre ni la dirección del receptor, ni los nombres de las aplicaciones permitidas.</string>
    <string name="diagnostics_copy_button">Copiar información de diagnóstico</string>
    <string name="diagnostics_copied">Información copiada</string>
    <string name="settings_dumbphone_mode">Modo dumbphone</string>
    <string name="settings_dumbphone_mode_desc">Funciona en silencio: notificación de estado mínima, reconexión automática y un aviso solo si falla una transferencia.</string>
