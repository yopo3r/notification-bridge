    <string name="onboarding_step1_title">Was diese App macht</string>
    <string name="onboarding_step1_desc">Notification Bridge sendet die Benachrichtigungen dieses Telefons per Bluetooth an ein anderes Gerät (z. B. ein einfaches Telefon) weiter, ohne Internet und ohne App auf der Empfängerseite.</string>
    <string name="onboarding_step2_title">Das andere Gerät koppeln</string>
    <string name="onboarding_step2_desc">Koppeln Sie das empfangende Telefon vor der Nutzung über die Bluetooth-Einstellungen von Android — genau wie beim Koppeln von Kopfhörern.</string>
    <string name="onboarding_step3_title">Bluetooth-Gerät auswählen</string>
    <string name="onboarding_step3_desc">Wählen Sie im Tab Test dieser App aus der Liste das bereits gekoppelte Gerät aus, das die Benachrichtigungen empfangen soll.</string>
    <string name="onboarding_step4_title">Benachrichtigungszugriff erteilen</string>
    <string name="onboarding_step4_desc">Tippen Sie unter Start auf \"Benachrichtigungszugriff\" und aktivieren Sie die Berechtigung für diese App in den Systemeinstellungen. Ohne diesen Schritt kann keine Benachrichtigung gelesen werden.</string>
    <string name="onboarding_step5_title">Weiterzuleitende Apps auswählen</string>
    <string name="onboarding_step5_desc">Aktivieren Sie unter Einstellungen die Apps, deren Benachrichtigungen weitergeleitet werden sollen (WhatsApp, E-Mail usw.), und schalten Sie \"Bridge aktivieren\" ein.</string>
    <string name="onboarding_step6_title">Test senden</string>
    <string name="onboarding_step6_desc">Tippen Sie im Tab Test auf \"Testdatei senden\", um zu bestätigen, dass die Bluetooth-Übertragung funktioniert, bevor Sie sich auf echte Benachrichtigungen verlassen.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Tutorial anzeigen</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Sendet Android-Benachrichtigungen per Bluetooth (OBEX Object Push) an ein anderes Gerät weiter, gedacht für die Nutzung neben einem einfachen Telefon ohne eigene Apps.</string>
    <string name="about_purpose_title">Zweck des Projekts</string>
    <string name="about_purpose_body">Ein persönliches Open-Source-Projekt, um zu sehen, wer schreibt oder anruft, ohne auf ein Smartphone mit Internet als Hauptgerät angewiesen zu sein.</string>
    <string name="about_technical_title">Technische Zusammenfassung</string>
    <string name="about_technical_body">NotificationListenerService + Warteschlange im Speicher + selbst geschriebener OBEX-Object-Push-Client über einen RFCOMM-Bluetooth-Socket. Getestet mit einem Alcatel 3080A als Empfänger.</string>
    <string name="about_technologies_title">Verwendete Technologien</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">Lizenz</string>
    <string name="about_license_body">MIT — siehe die LICENSE-Datei im Repository.</string>

    <!-- History, diagnostics, dumbphone mode, system notifications -->
    <string name="tab_history">Verlauf</string>
