    <!-- Onboarding -->
    <string name="onboarding_step_indicator">Шаг %1$d из %2$d</string>
    <string name="onboarding_next">Далее</string>
    <string name="onboarding_back">Назад</string>
    <string name="onboarding_skip">Пропустить</string>
    <string name="onboarding_finish">Начать</string>
    <string name="onboarding_step1_title">Что делает это приложение</string>
    <string name="onboarding_step1_desc">Notification Bridge пересылает уведомления этого телефона на другое устройство (например, кнопочный телефон) по Bluetooth — без интернета и без установки приложения на приёмнике.</string>
    <string name="onboarding_step2_title">Сопрягите другое устройство</string>
    <string name="onboarding_step2_desc">Перед использованием приложения выполните сопряжение принимающего телефона в настройках Bluetooth Android — так же, как с наушниками.</string>
    <string name="onboarding_step3_title">Выберите Bluetooth-устройство</string>
    <string name="onboarding_step3_desc">На вкладке «Приёмник» этого приложения выберите из списка уже сопряжённое устройство, которое будет получать уведомления.</string>
    <string name="onboarding_step4_title">Предоставьте доступ к уведомлениям</string>
    <string name="onboarding_step4_desc">На главной странице нажмите «Доступ к уведомлениям» и включите разрешение для этого приложения в системных настройках. Без этого шага уведомления прочитать нельзя.</string>
    <string name="onboarding_step5_title">Выберите приложения для пересылки</string>
    <string name="onboarding_step5_desc">В настройках отметьте приложения, уведомления которых нужно пересылать (WhatsApp, почта и т. д.), и включите «Включить мост».</string>
    <string name="onboarding_step6_title">Отправьте тест</string>
    <string name="onboarding_step6_desc">На вкладке «Приёмник» нажмите «Отправить тестовый файл», чтобы убедиться, что передача по Bluetooth работает, прежде чем полагаться на настоящие уведомления.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Показать обучение</string>
    <string name="about_version">Версия %1$s</string>
    <string name="about_description">Пересылает уведомления Android на другое устройство по Bluetooth (OBEX Object Push). Предназначено для использования вместе с кнопочным телефоном без собственных приложений.</string>
    <string name="about_purpose_title">Цель проекта</string>
    <string name="about_purpose_body">Личный проект с открытым исходным кодом, чтобы видеть, кто пишет или звонит, не завися от смартфона с интернетом как основного устройства.</string>
    <string name="about_technical_title">Техническое описание</string>
    <string name="about_technical_body">NotificationListenerService + очередь в памяти + собственный клиент OBEX Object Push поверх Bluetooth-сокета RFCOMM. Проверено с Alcatel 3080A в качестве приёмника.</string>
    <string name="about_technologies_title">Используемые технологии</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">Лицензия</string>
    <string name="about_license_body">MIT — см. файл LICENSE в репозитории.</string>

