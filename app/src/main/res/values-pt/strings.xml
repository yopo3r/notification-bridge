    <string name="onboarding_finish">Começar</string>
    <string name="onboarding_step1_title">O que este app faz</string>
    <string name="onboarding_step1_desc">O Notification Bridge reenvia as notificações deste telefone para outro dispositivo (por exemplo, um telefone básico) via Bluetooth, sem precisar de Internet nem de nenhum app no receptor.</string>
    <string name="onboarding_step2_title">Pareie o outro dispositivo</string>
    <string name="onboarding_step2_desc">Antes de usar o app, pareie o telefone receptor nas configurações de Bluetooth do Android — assim como pareia um fone de ouvido.</string>
    <string name="onboarding_step3_title">Escolha o dispositivo Bluetooth</string>
    <string name="onboarding_step3_desc">Na aba Teste deste app, escolha na lista o dispositivo já pareado que vai receber as notificações.</string>
    <string name="onboarding_step4_title">Conceda acesso às notificações</string>
    <string name="onboarding_step4_desc">Em Início, toque em \"Acesso às notificações\" e ative a permissão para este app nas configurações do sistema. Sem esse passo, nenhuma notificação pode ser lida.</string>
    <string name="onboarding_step5_title">Escolha quais apps reenviar</string>
    <string name="onboarding_step5_desc">Em Configurações, marque os apps cujas notificações você quer reenviar (WhatsApp, e-mail, etc.) e ative \"Ativar ponte\".</string>
    <string name="onboarding_step6_title">Envie um teste</string>
    <string name="onboarding_step6_desc">Na aba Teste, toque em \"Enviar arquivo de teste\" para confirmar que a transferência por Bluetooth funciona antes de depender de notificações reais.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Ver tutorial</string>
    <string name="about_version">Versão %1$s</string>
    <string name="about_description">Reenvia notificações do Android para outro dispositivo via Bluetooth (OBEX Object Push), pensado para usar junto com um telefone básico sem apps próprios.</string>
    <string name="about_purpose_title">Propósito do projeto</string>
    <string name="about_purpose_body">Projeto pessoal de código aberto para saber quem está escrevendo ou ligando sem depender de um smartphone com Internet como dispositivo principal.</string>
    <string name="about_technical_title">Resumo técnico</string>
    <string name="about_technical_body">NotificationListenerService + fila em memória + cliente OBEX Object Push próprio sobre um socket Bluetooth RFCOMM. Testado com um Alcatel 3080A como receptor.</string>
    <string name="about_technologies_title">Tecnologias utilizadas</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">Licença</string>
    <string name="about_license_body">MIT — veja o arquivo LICENSE no repositório.</string>

