    <string name="diagnostics_title">Diagnostic</string>
    <string name="diagnostics_intro">Le rapport indique les versions de l’application et d’Android, le modèle du téléphone, les réglages et l’état technique. Les détails des erreurs et le journal sont omis, car ils peuvent contenir des données personnelles. Vérifiez le rapport avant de le partager. Il exclut le contenu des notifications, le nom et l’adresse du récepteur, ainsi que les noms des applications autorisées.</string>
    <string name="diagnostics_copy_button">Copier les informations de diagnostic</string>
    <string name="diagnostics_copied">Informations copiées</string>
    <string name="settings_dumbphone_mode">Mode dumbphone</string>
    <string name="settings_dumbphone_mode_desc">Fonctionne en silence : notification d\'état minimale, reconnexion automatique et alerte uniquement si un transfert échoue.</string>
