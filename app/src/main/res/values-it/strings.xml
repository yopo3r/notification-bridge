    <!-- Onboarding -->
    <string name="onboarding_step_indicator">Passaggio %1$d di %2$d</string>
    <string name="onboarding_next">Avanti</string>
    <string name="onboarding_back">Indietro</string>
    <string name="onboarding_skip">Salta</string>
    <string name="onboarding_finish">Inizia</string>
    <string name="onboarding_step1_title">Cosa fa questa app</string>
    <string name="onboarding_step1_desc">Notification Bridge reinvia le notifiche di questo telefono a un altro dispositivo (ad esempio un telefono base) via Bluetooth, senza bisogno di Internet né di alcuna app sul ricevitore.</string>
    <string name="onboarding_step2_title">Abbina l\'altro dispositivo</string>
    <string name="onboarding_step2_desc">Prima di usare l\'app, abbina il telefono ricevente dalle impostazioni Bluetooth di Android — proprio come si abbinano delle cuffie.</string>
    <string name="onboarding_step3_title">Scegli il dispositivo Bluetooth</string>
    <string name="onboarding_step3_desc">Nella scheda Ricevitore di questa app, scegli dall\'elenco il dispositivo già abbinato che riceverà le notifiche.</string>
    <string name="onboarding_step4_title">Concedi l\'accesso alle notifiche</string>
    <string name="onboarding_step4_desc">Da Home, tocca \"Accesso alle notifiche\" e attiva il permesso per questa app nelle impostazioni di sistema. Senza questo passaggio non è possibile leggere alcuna notifica.</string>
    <string name="onboarding_step5_title">Scegli quali app reinviare</string>
    <string name="onboarding_step5_desc">In Impostazioni, seleziona le app di cui vuoi reinviare le notifiche (WhatsApp, e-mail, ecc.) e attiva \"Attiva il bridge\".</string>
    <string name="onboarding_step6_title">Invia una prova</string>
    <string name="onboarding_step6_desc">Nella scheda Ricevitore, tocca \"Invia file di prova\" per verificare che il trasferimento Bluetooth funzioni prima di fare affidamento su notifiche reali.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Vedi tutorial</string>
    <string name="about_version">Versione %1$s</string>
    <string name="about_description">Reinvia le notifiche Android a un altro dispositivo via Bluetooth (OBEX Object Push), pensata per l\'uso insieme a un telefono base senza app proprie.</string>
    <string name="about_purpose_title">Scopo del progetto</string>
    <string name="about_purpose_body">Progetto personale open source per sapere chi scrive o chiama senza dipendere da uno smartphone con Internet come dispositivo principale.</string>
    <string name="about_technical_title">Riepilogo tecnico</string>
    <string name="about_technical_body">NotificationListenerService + coda in memoria + client OBEX Object Push scritto da zero su un socket Bluetooth RFCOMM. Testato con un Alcatel 3080A come ricevitore.</string>
    <string name="about_technologies_title">Tecnologie utilizzate</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">Licenza</string>
    <string name="about_license_body">MIT — vedi il file LICENSE nel repository.</string>

