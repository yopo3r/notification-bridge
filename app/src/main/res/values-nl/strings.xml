    <string name="onboarding_step1_title">Wat deze app doet</string>
    <string name="onboarding_step1_desc">Notification Bridge stuurt de meldingen van deze telefoon via Bluetooth door naar een ander apparaat (bijv. een eenvoudige telefoon), zonder internet en zonder app op de ontvanger.</string>
    <string name="onboarding_step2_title">Koppel het andere apparaat</string>
    <string name="onboarding_step2_desc">Koppel de ontvangende telefoon vóór gebruik via de Bluetooth-instellingen van Android — net zoals je een koptelefoon koppelt.</string>
    <string name="onboarding_step3_title">Kies het Bluetooth-apparaat</string>
    <string name="onboarding_step3_desc">Kies op het tabblad Test van deze app het al gekoppelde apparaat uit de lijst dat de meldingen zal ontvangen.</string>
    <string name="onboarding_step4_title">Toegang tot meldingen verlenen</string>
    <string name="onboarding_step4_desc">Tik op Start op \"Toegang tot meldingen\" en schakel de toestemming voor deze app in bij de systeeminstellingen. Zonder deze stap kan geen enkele melding worden gelezen.</string>
    <string name="onboarding_step5_title">Kies welke apps worden doorgestuurd</string>
    <string name="onboarding_step5_desc">Vink bij Instellingen de apps aan waarvan je meldingen wilt doorsturen (WhatsApp, e-mail, enz.) en schakel \"Bridge inschakelen\" in.</string>
    <string name="onboarding_step6_title">Stuur een test</string>
    <string name="onboarding_step6_desc">Tik op het tabblad Test op \"Testbestand verzenden\" om te bevestigen dat de Bluetooth-overdracht werkt voordat je op echte meldingen vertrouwt.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Tutorial bekijken</string>
    <string name="about_version">Versie %1$s</string>
    <string name="about_description">Stuurt Android-meldingen via Bluetooth (OBEX Object Push) door naar een ander apparaat, bedoeld voor gebruik naast een eenvoudige telefoon zonder eigen apps.</string>
    <string name="about_purpose_title">Doel van het project</string>
    <string name="about_purpose_body">Een persoonlijk open source project om te zien wie er belt of schrijft, zonder afhankelijk te zijn van een smartphone met internet als hoofdapparaat.</string>
    <string name="about_technical_title">Technische samenvatting</string>
    <string name="about_technical_body">NotificationListenerService + wachtrij in het geheugen + zelfgeschreven OBEX Object Push-client via een RFCOMM Bluetooth-socket. Getest met een Alcatel 3080A als ontvanger.</string>
    <string name="about_technologies_title">Gebruikte technologieën</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">Licentie</string>
    <string name="about_license_body">MIT — zie het LICENSE-bestand in de repository.</string>

