    <string name="onboarding_step1_title">이 앱이 하는 일</string>
    <string name="onboarding_step1_desc">Notification Bridge는 이 휴대폰의 알림을 Bluetooth로 다른 기기(예: 폴더폰)에 전달합니다. 인터넷이 필요 없고, 수신 기기에 앱을 설치할 필요도 없습니다.</string>
    <string name="onboarding_step2_title">상대 기기 페어링</string>
    <string name="onboarding_step2_desc">앱을 사용하기 전에 Android의 Bluetooth 설정에서 수신 휴대폰을 페어링하세요. 이어폰을 페어링하는 것과 같은 방법입니다.</string>
    <string name="onboarding_step3_title">Bluetooth 기기 선택</string>
    <string name="onboarding_step3_desc">이 앱의 수신 기기 탭에서 알림을 받을 기기를 페어링된 기기 목록에서 선택하세요.</string>
    <string name="onboarding_step4_title">알림 접근 허용</string>
    <string name="onboarding_step4_desc">홈에서 “알림 접근”을 누르고 시스템 설정에서 이 앱의 권한을 켜세요. 이 단계를 거치지 않으면 알림을 읽을 수 없습니다.</string>
    <string name="onboarding_step5_title">전달할 앱 선택</string>
    <string name="onboarding_step5_desc">설정에서 알림을 전달할 앱(WhatsApp, 이메일 등)을 체크하고 “브리지 사용”을 켜세요.</string>
    <string name="onboarding_step6_title">테스트 보내기</string>
    <string name="onboarding_step6_desc">수신 기기 탭에서 “테스트 파일 보내기”를 눌러, 실제 알림에 의존하기 전에 Bluetooth 전송이 작동하는지 확인하세요.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">튜토리얼 보기</string>
    <string name="about_version">버전 %1$s</string>
    <string name="about_description">Android 알림을 Bluetooth(OBEX Object Push)로 다른 기기에 전달합니다. 자체 앱이 없는 폴더폰과 함께 사용하도록 만들었습니다.</string>
    <string name="about_purpose_title">프로젝트 목적</string>
    <string name="about_purpose_body">인터넷에 연결된 스마트폰을 주 기기로 쓰지 않고도 누가 문자나 전화를 했는지 확인하기 위한 개인 오픈소스 프로젝트입니다.</string>
    <string name="about_technical_title">기술 요약</string>
    <string name="about_technical_body">NotificationListenerService + 메모리 내 대기열 + RFCOMM Bluetooth 소켓 위에서 직접 구현한 OBEX Object Push 클라이언트. 수신 기기로 Alcatel 3080A에서 테스트했습니다.</string>
    <string name="about_technologies_title">사용한 기술</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">라이선스</string>
    <string name="about_license_body">MIT — 저장소의 LICENSE 파일을 참조하세요.</string>

