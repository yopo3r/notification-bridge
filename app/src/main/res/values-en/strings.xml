    <string name="onboarding_step1_title">What this app does</string>
    <string name="onboarding_step1_desc">Notification Bridge forwards this phone\'s notifications to another device (e.g. a basic phone) over Bluetooth, with no Internet and no app needed on the receiver.</string>
    <string name="onboarding_step2_title">Pair the other device</string>
    <string name="onboarding_step2_desc">Before using the app, pair the receiving phone from Android\'s Bluetooth settings — just like pairing a pair of headphones.</string>
    <string name="onboarding_step3_title">Pick the Bluetooth device</string>
    <string name="onboarding_step3_desc">In the Test tab of this app, pick the already-paired device from the list that will receive the notifications.</string>
    <string name="onboarding_step4_title">Grant notification access</string>
    <string name="onboarding_step4_desc">From Home, tap \"Notification access\" and enable the permission for this app in the system settings. Without this step, no notification can be read.</string>
    <string name="onboarding_step5_title">Choose which apps to forward</string>
    <string name="onboarding_step5_desc">In Settings, check the apps whose notifications you want forwarded (WhatsApp, email, etc.), and turn on \"Enable bridge\".</string>
    <string name="onboarding_step6_title">Send a test</string>
    <string name="onboarding_step6_desc">In the Test tab, tap \"Send test file\" to confirm the Bluetooth transfer works before relying on real notifications.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Show tutorial</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Forwards Android notifications to another device over Bluetooth (OBEX Object Push), designed to use alongside a basic phone with no apps of its own.</string>
    <string name="about_purpose_title">Project purpose</string>
    <string name="about_purpose_body">A personal open-source project to see who\'s texting or calling without depending on a smartphone with Internet as your main device.</string>
    <string name="about_technical_title">Technical summary</string>
    <string name="about_technical_body">NotificationListenerService + in-memory queue + a hand-written OBEX Object Push client over an RFCOMM Bluetooth socket. Tested against an Alcatel 3080A as the receiver.</string>
    <string name="about_technologies_title">Technologies used</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">License</string>
    <string name="about_license_body">MIT — see the LICENSE file in the repository.</string>

