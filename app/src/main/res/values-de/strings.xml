    <string name="history_title">Letzte Übertragungen</string>
    <string name="history_privacy_note">Es werden nur App-Name und Titel gespeichert, ausschließlich im Arbeitsspeicher; sie gehen verloren, wenn die App vollständig beendet wird.</string>
    <string name="history_empty">Noch keine Übertragungen.</string>
    <string name="history_clear">Verlauf löschen</string>
    <string name="history_status_sent">Gesendet</string>
    <string name="history_status_failed">Fehler</string>
    <string name="diagnostics_title">Diagnose</string>
    <string name="diagnostics_intro">Der Bericht enthält App- und Android-Version, Telefonmodell, Einstellungen und technischen Status. Fehlerdetails und Protokoll werden ausgelassen, da sie personenbezogene Daten enthalten können. Prüfen Sie den Bericht vor dem Teilen. Benachrichtigungsinhalte, Name und Adresse des Empfängers sowie Namen erlaubter Apps sind ausgeschlossen.</string>
    <string name="diagnostics_copy_button">Diagnoseinformationen kopieren</string>
    <string name="diagnostics_copied">Informationen kopiert</string>
    <string name="settings_dumbphone_mode">Dumbphone-Modus</string>
    <string name="settings_dumbphone_mode_desc">Läuft still im Hintergrund: minimale Statusbenachrichtigung, automatische Wiederverbindung und ein Hinweis nur bei fehlgeschlagener Übertragung.</string>
