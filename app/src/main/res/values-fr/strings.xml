    <string name="onboarding_step1_title">Ce que fait cette application</string>
    <string name="onboarding_step1_desc">Notification Bridge transfère les notifications de ce téléphone vers un autre appareil (par exemple un téléphone basique) par Bluetooth, sans Internet ni application côté récepteur.</string>
    <string name="onboarding_step2_title">Jumeler l\'autre appareil</string>
    <string name="onboarding_step2_desc">Avant d\'utiliser l\'application, jumelez le téléphone récepteur depuis les paramètres Bluetooth d\'Android — comme pour des écouteurs.</string>
    <string name="onboarding_step3_title">Choisir l\'appareil Bluetooth</string>
    <string name="onboarding_step3_desc">Dans l\'onglet Test de cette application, choisissez dans la liste l\'appareil déjà jumelé qui recevra les notifications.</string>
    <string name="onboarding_step4_title">Autoriser l\'accès aux notifications</string>
    <string name="onboarding_step4_desc">Depuis Accueil, touchez \"Accès aux notifications\" et activez l\'autorisation pour cette application dans les paramètres système. Sans cette étape, aucune notification ne peut être lue.</string>
    <string name="onboarding_step5_title">Choisir les applications à transférer</string>
    <string name="onboarding_step5_desc">Dans Paramètres, cochez les applications dont vous voulez transférer les notifications (WhatsApp, e-mail, etc.), puis activez \"Activer le pont\".</string>
    <string name="onboarding_step6_title">Envoyer un test</string>
    <string name="onboarding_step6_desc">Dans l\'onglet Test, touchez \"Envoyer un fichier test\" pour confirmer que le transfert Bluetooth fonctionne avant de compter sur de vraies notifications.</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">Voir le tutoriel</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Transfère les notifications Android vers un autre appareil par Bluetooth (OBEX Object Push), conçu pour être utilisé avec un téléphone basique sans application propre.</string>
    <string name="about_purpose_title">Objectif du projet</string>
    <string name="about_purpose_body">Projet personnel open source pour savoir qui écrit ou appelle sans dépendre d\'un smartphone connecté à Internet comme appareil principal.</string>
    <string name="about_technical_title">Résumé technique</string>
    <string name="about_technical_body">NotificationListenerService + file d\'attente en mémoire + client OBEX Object Push maison sur un socket Bluetooth RFCOMM. Testé avec un Alcatel 3080A comme récepteur.</string>
    <string name="about_technologies_title">Technologies utilisées</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">Licence</string>
    <string name="about_license_body">MIT — voir le fichier LICENSE dans le dépôt.</string>

