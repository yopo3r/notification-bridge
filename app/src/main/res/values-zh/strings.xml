    <string name="onboarding_step1_title">这个应用能做什么</string>
    <string name="onboarding_step1_desc">Notification Bridge 通过蓝牙将这部手机的通知转发到另一台设备（例如老人机），无需联网，接收设备上也无需安装任何应用。</string>
    <string name="onboarding_step2_title">配对另一台设备</string>
    <string name="onboarding_step2_desc">使用本应用前，请先在 Android 蓝牙设置中配对接收手机，方法与配对耳机相同。</string>
    <string name="onboarding_step3_title">选择蓝牙设备</string>
    <string name="onboarding_step3_desc">在本应用的“接收设备”标签页中，从列表里选择用于接收通知的已配对设备。</string>
    <string name="onboarding_step4_title">授予通知访问权限</string>
    <string name="onboarding_step4_desc">在首页点按“通知访问权限”，并在系统设置中为本应用开启该权限。没有这一步，就无法读取通知。</string>
    <string name="onboarding_step5_title">选择要转发的应用</string>
    <string name="onboarding_step5_desc">在“设置”中勾选要转发通知的应用（WhatsApp、电子邮件等），然后打开“启用桥接”。</string>
    <string name="onboarding_step6_title">发送测试</string>
    <string name="onboarding_step6_desc">在“接收设备”标签页中点按“发送测试文件”，在依赖真实通知之前，先确认蓝牙传输可以正常工作。</string>

    <!-- About -->
    <string name="settings_show_tutorial_button">显示教程</string>
    <string name="about_version">版本 %1$s</string>
    <string name="about_description">通过蓝牙（OBEX Object Push）将 Android 通知转发到另一台设备，适合搭配没有自带应用的老人机使用。</string>
    <string name="about_purpose_title">项目目的</string>
    <string name="about_purpose_body">这是一个个人开源项目，让你无需把联网的智能手机当作主力设备，也能知道是谁发来了短信或打来了电话。</string>
    <string name="about_technical_title">技术概述</string>
    <string name="about_technical_body">NotificationListenerService + 内存队列 + 基于 RFCOMM 蓝牙套接字自行实现的 OBEX Object Push 客户端。已使用 Alcatel 3080A 作为接收设备进行测试。</string>
    <string name="about_technologies_title">使用的技术</string>
    <string name="about_technologies_body">Kotlin • Jetpack Compose • Material 3 • Jetpack DataStore • Bluetooth Classic (RFCOMM) • OBEX Object Push</string>
    <string name="about_license_title">许可证</string>
    <string name="about_license_body">MIT — 请参阅仓库中的 LICENSE 文件。</string>

